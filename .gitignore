# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# APK files (will be uploaded to GitHub Releases instead)
*.apk
*.aab

# Build outputs and logs
build_log.txt
build_output.txt

# Local configuration
local.properties
android/key.properties
android/**/*.jks
android/**/*.keystore

# Bundled ebook assets (large files, keep out of git)
/android/app/src/main/assets/ebooks/
/android/app/src/main/assets/ebooks/**
elimupepe-8acc4-firebase-adminsdk-*.json

# Signing material and secrets (never commit)
*.jks
*.keystore
*.p12
android/key.properties
android/keystore.properties
android/*.secret.properties
android/app/*.secret.properties

# Golden test diff output
test/**/failures/
